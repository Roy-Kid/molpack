# The partner commits CI builds molpack against -- the ONE place they are
# pinned. Every workflow reads this file (ci.yml and both publish workflows),
# and so do the git hooks (scripts/partners.py), so a local push is built and
# tested against the same molrs commit as CI -- never against whatever the
# sibling ../molrs happens to have checked out.
#
# KEY=VALUE lines only (CI appends them to $GITHUB_ENV). SELF is this
# repository's directory in CI's sibling layout (molpack/, molrs/).
#
# Edited by hand, deliberately (law P3). Bump a ref in its own commit and
# relock in the same commit -- Cargo.lock, python/Cargo.lock and python/uv.lock
# record the pinned molrs version and their dependencies:
#   scripts/partners.py run -- sh -c 'cargo update -w && (cd python && cargo update -w && uv lock) \
#     && cp Cargo.lock "$PARTNERS_SOURCE/" && cp python/Cargo.lock python/uv.lock "$PARTNERS_SOURCE/python/"'
# A release commit pins the molrs release tag's commit of the line Cargo.toml
# names (the publish workflows build the wheel and the crate against it).
SELF=molpack
MOLRS_REPOSITORY=MolCrafts/molrs
MOLRS_REF=3846260bc3a078907d50d32f1937b0e25d63d959
